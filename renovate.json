{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "gitAuthor": "Renovate Bot <renovate@biggerworld.invalid>",
  "pinDigests": true,
  "ignorePaths": [
    "**/node_modules/**",
    "k8s/flux/flux-system/gotk-components.yaml"
  ],
  "kubernetes": {
    "managerFilePatterns": [
      "/^k8s/.+\\.ya?ml$/"
    ]
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "ghcr.io/dev-stacc/**"
      ],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres"
      ],
      "enabled": false
    }
  ],
  "flux": {
    "managerFilePatterns": [
      "/^k8s/.+\\.ya?ml$/"
    ]
  },
  "prHourlyLimit": 3
}
